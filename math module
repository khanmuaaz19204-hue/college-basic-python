def add(a,b):
    return a+b
def subtract(a,b):
    return a-b
def sqrt(a):
    return a**0.5
def multiply(a,b):
    return a*b
def divide(a,b):
    return a/b
def square(n):
    return n*n
def cube(n):
    return n*n*n
def c_to_f(c):
    return (c*9/5)+32
def f_to_c(f):
    return (f-32)*5/9
def Circle(r):
    return PI*r*r
def Rectangle(l,b):
    return l*b
def Triangle(b,h):
    return (1/2*b*h)
PI=3.14159
